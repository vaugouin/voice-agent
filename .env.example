OPENAI_API_KEY=sk-your-key-here
OPENAI_TEXT_MODEL=gpt-6-sol
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Deep-dive voice answers (POST /deep-answer, VOICE-AGENT-197): the model that writes the answer
# server-side from the full record, separate from OPENAI_TEXT_MODEL because its latency adds to a
# voice turn. Effort: none | low | medium | high, or "default" to send no reasoning setting.
# Bench of 2026-10-03: gpt-6-sol at none 3.75 s, as fast as gpt-6-luna and with cleaner answers.
DEEP_ANSWER_MODEL=gpt-6-sol
DEEP_ANSWER_REASONING_EFFORT=none
ENABLE_STRUCTURED_CARD_FOCUS=true
# Native subtitle lanes, server default for every session (assistant = bottom overlay, user
# transcript = top lane). Overridable without editing this file: per session with
# ?spokenSubtitles=0/1 and ?userTranscriptSubtitles=0/1 on the page URL (the App Menu toggles
# write those), or for the whole run from the command line: `python -m app --no-subtitles`
# (local) or `docker run -e ENABLE_SPOKEN_SUBTITLES=false ...` (the -e flag beats --env-file).
ENABLE_SPOKEN_SUBTITLES=false
ENABLE_USER_TRANSCRIPT_SUBTITLES=false
REALTIME_TRANSCRIPTION_LANGUAGE=

# FastAPI/FastMCP text2sql REST endpoint.
TEXT2SQL_BASE_URL=http://your_host:8000
TEXT2SQL_API_KEY_NAME=X-API-Key
TEXT2SQL_API_KEY_VALUE=your_api_key_value
TEXT2SQL_ROWS_PER_PAGE=50

# Fallback voice, used ONLY by a persona that declares no `voice:` of its own. Every persona
# shipped today declares one, so editing this line will look like it does nothing: the startup
# banner prints the resolved voice and where it came from. Use `?voice=<name>` to override.
# AGENT_VOICE=alloy
AGENT_VOICE=ash
# AGENT_VOICE=ballad
# AGENT_VOICE=coral
# AGENT_VOICE=echo
# AGENT_VOICE=sage
# AGENT_VOICE=shimmer
# AGENT_VOICE=verse
# AGENT_VOICE=marin
# AGENT_VOICE=cedar
# Default persona: `default` (SOUL.md) or any souls/<slug>.md: video-store, scholar, chatterbox.
# A `?soul=<slug>` URL parameter overrides it per session; GET /souls lists what is available.
# An unknown value falls back to `default` and logs a WARNING at startup.
AGENT_SOUL=default
#AGENT_SOUL=chatterbox
#AGENT_SOUL=video-store
#AGENT_SOUL=scholar

# The clock the agent reasons with: today's date is injected into both prompts in this zone,
# so "the last episode that aired" is read against a real day instead of the model's training.
# An unknown zone falls back to UTC.
AGENT_TIMEZONE=Europe/Paris

# Language the speech-to-text step expects to hear. Empty (the default) means auto-detect,
# which is what a bilingual demo needs: a transcriber pinned to one language does not degrade
# when another is spoken, it returns a fluent and wrong sentence in the pinned language. Set it
# to a code such as en only if auto-detection proves unreliable on short turns.
REALTIME_TRANSCRIPTION_LANGUAGE=
# Languages the speech-to-text step should expect, as a hint and not a lock: auto-detection
# stays on between them (gpt-transcribe and later; older models ignore it). Comma-separated
# codes, empty for no hint. A pinned REALTIME_TRANSCRIPTION_LANGUAGE wins on the voice path.
TRANSCRIPTION_LANGUAGES=en,fr
