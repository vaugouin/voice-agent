# .env.example: template for sync_vps_docker.py credentials and folder pairs.
# Copy to .env (which is git/docker-ignored) and fill in the real values:
#   copy .env.example .env
# Real environment variables override .env; CLI flags override both.
# An older .env with VPS_REMOTE / VPS_LOCAL / VPS_EXTRA_ROOTS is refused; convert it
# with: python sync_vps_docker.py --migrate-env --dry-run   (then without --dry-run)

# Connection target (required):
VPS_HOST=your.vps.host.or.ip
VPS_PORT=22

# SSH user. root lets the sync read root-owned files (TLS keys, ChromaDB store).
VPS_USER=root

# SSH password. Prefer a key (VPS_KEY_FILE) over a password where possible.
VPS_SSH_PASSWORD=

# Optional: private key path (used instead of the password if set):
# VPS_KEY_FILE=C:\Users\you\.ssh\id_ed25519

# Folders to mirror, VPS -> local (at least one required). One pair per line:
#   VPS_SYNC_<suffix>=/remote/folder -> C:\local\folder [keep|delete]
# - Pairs run in natural suffix order (2 before 10); comment a line out to skip it.
# - A relative local folder resolves against this .env's folder.
# - Optional tag: [keep] never deletes in that pair, [delete] always propagates
#   deletions there; without a tag the pair follows VPS_DELETE below.
# - A pair may sit inside another pair only at the same relative place on both
#   sides (remote and local). The outer pair then leaves that subtree to the inner
#   one, so a [keep] on the inner pair protects it from the outer pair's deletions.
#   Any other overlap, or two pairs sharing a folder, stops the run before it
#   connects.
# - Run one pair only with --only <suffix>; replace them all for one run with
#   --sync "/remote -> C:\local".
# Reading most system folders needs root (VPS_USER=root). Typical set:
VPS_SYNC_1=/home/debian/docker -> C:\path\to\mirror\home\debian\docker
VPS_SYNC_2=/home/debian/docker/damp-vaugouin-com/mariadb_backups -> C:\path\to\mirror\home\debian\docker\damp-vaugouin-com\mariadb_backups [keep]
# cert-renewal (root) and crawler (debian) schedules
VPS_SYNC_3=/var/spool/cron/crontabs -> C:\path\to\mirror\var\spool\cron\crontabs
# WordPress DB, Grafana/Prometheus/Alertmanager, ...
VPS_SYNC_4=/var/lib/docker/volumes -> C:\path\to\mirror\var\lib\docker\volumes
# authoritative bind9 zone files (outside Docker)
VPS_SYNC_5=/var/lib/bind -> C:\path\to\mirror\var\lib\bind
# system config incl. legacy /etc/letsencrypt, sshd, ufw, /etc/bind
VPS_SYNC_6=/etc -> C:\path\to\mirror\etc
# .ssh/.gnupg/.docker/dotfiles (skips .../docker, which is pair 1)
VPS_SYNC_7=/home/debian -> C:\path\to\mirror\home\debian
# root .ssh/.gnupg/dotfiles
VPS_SYNC_8=/root -> C:\path\to\mirror\root

# Default for pairs without a tag: propagate deletions from the VPS?
#   false (default, also when absent or empty): additive sync, nothing deleted.
#   true: local files and folders that no longer exist on the VPS are deleted.
# Accepted values: true/1/yes/on or false/0/no/off. Anything else stops the run.
# Check with --dry-run first: it prints WOULD DELETE (file|dir) lines.
VPS_DELETE=false
